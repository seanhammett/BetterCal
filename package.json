{
  "name": "bettercal",
  "private": true,
  "version": "1.0.0",
  "description": "Google Calendar as an infinite vertical scroll of weeks (Chrome extension)",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  }
}
