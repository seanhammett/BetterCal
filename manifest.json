{
  "manifest_version": 3,
  "name": "nonstop",
  "version": "1.0.0",
  "description": "Your Google Calendar as one continuous, infinitely scrolling run of weeks. No ads, no tracking, no accounts.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open nonstop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://www.googleapis.com https://oauth2.googleapis.com; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "oauth2": {
    "client_id": "144819819650-svune6ojidas8shs774s58sf8sl1n3v2.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.calendars",
      "https://www.googleapis.com/auth/calendar.calendarlist"
    ]
  }
}
